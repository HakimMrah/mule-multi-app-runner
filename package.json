{
  "name": "multi-app-runner-mule",
  "displayName": "Multi-App Runner for Mule",
  "description": "Run or debug several Mule apps together in one shared runtime with Anypoint Code Builder: pick them in the Run and Debug list, no launch configuration to write.",
  "version": "0.6.3",
  "publisher": "hmrah",
  "author": "Hakim MRAH",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "keywords": [
    "mule",
    "mulesoft",
    "anypoint code builder",
    "debug",
    "multi-root",
    "runtime"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node test/run.js",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository"
  },
  "activationEvents": [
    "onStartupFinished",
    "onDebugDynamicConfigurations:mule-xml-debugger",
    "onDebugResolve:mule-xml-debugger"
  ],
  "contributes": {
    "commands": [
      {
        "command": "muleMultiApp.debug",
        "title": "Debug All Open Mule Apps",
        "category": "Mule",
        "icon": "$(debug-alt)"
      },
      {
        "command": "muleMultiApp.run",
        "title": "Run All Open Mule Apps",
        "category": "Mule",
        "icon": "$(run-all)"
      },
      {
        "command": "muleMultiApp.debugSelected",
        "title": "Debug Some Open Mule Apps...",
        "category": "Mule"
      },
      {
        "command": "muleMultiApp.runSelected",
        "title": "Run Some Open Mule Apps...",
        "category": "Mule"
      },
      {
        "command": "muleMultiApp.showLog",
        "title": "Show Multi-App Runner Log",
        "category": "Mule"
      },
      {
        "command": "muleMultiApp.removeEntries",
        "title": "Remove Multi-App Entries from Run and Debug",
        "category": "Mule"
      },
      {
        "command": "muleMultiApp.debugFolders",
        "title": "Debug Mule Apps Together",
        "category": "Mule",
        "icon": "$(debug-alt)"
      },
      {
        "command": "muleMultiApp.runFolders",
        "title": "Run Mule Apps Together",
        "category": "Mule",
        "icon": "$(run-all)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "muleMultiApp.debugFolders",
          "when": "explorerResourceIsRoot && workspaceFolderCount > 1",
          "group": "4_mule@1"
        },
        {
          "command": "muleMultiApp.runFolders",
          "when": "explorerResourceIsRoot && workspaceFolderCount > 1",
          "group": "4_mule@2"
        }
      ],
      "commandPalette": [
        {
          "command": "muleMultiApp.debugFolders",
          "when": "false"
        },
        {
          "command": "muleMultiApp.runFolders",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "muleMultiApp.debug",
        "key": "ctrl+alt+f5",
        "mac": "cmd+alt+f5"
      }
    ],
    "configuration": {
      "title": "Multi-App Runner for Mule",
      "properties": {
        "muleMultiApp.showStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show a \"Debug N Mule apps\" button in the status bar (when 2 or more Mule apps are open)."
        },
        "muleMultiApp.showProgress": {
          "type": "boolean",
          "default": true,
          "description": "Show launch progress (preparing, starting the runtime, N/M deployed) in a notification and in the status bar, until every app is deployed or failed."
        },
        "muleMultiApp.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace folder names never included in the shared runtime."
        },
        "muleMultiApp.addToRunAndDebugList": {
          "type": "boolean",
          "default": true,
          "description": "Write the \"Debug/Run all open Mule apps\" and \"Debug/Run selected Mule apps…\" entries at the top of the Run and Debug list. They are stored in the workspace file (.code-workspace or untitled workspace), never in a project's .vscode/launch.json, and kept in sync with the open folders. Off = entries under \"Mule Xml Debugger...\" instead."
        },
        "muleMultiApp.runtimeVersion": {
          "type": "string",
          "default": "",
          "description": "Force the Mule runtime version (e.g. 4.9.15). Empty = highest app.runtime found in the projects' poms (parent poms are read from the local Maven repository)."
        },
        "muleMultiApp.jdkVersion": {
          "type": "string",
          "default": "17",
          "description": "JDK major version used with the shared runtime."
        }
      }
    }
  }
}
